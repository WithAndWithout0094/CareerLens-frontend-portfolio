# Fill credentials locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

DATABASE_URL=postgresql://postgres:password@localhost:5432/careerlens
# Generate a distinct secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=careerlens
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
DATABASE_POOL_MAX_SIZE=10

APP_ENV=development
# Protected API routes require signed JWT authentication.
AUTH_ENABLED=true
ADMIN_USER_IDS=
# Only data imports require owner authorization; public portfolio GETs are sanitized.
REDIS_URL=
WORKER_CONCURRENCY=3
LLM_CONCURRENCY=3
DAILY_ANALYSIS_LIMIT=60
MEMBER_DAILY_ANALYSIS_LIMIT=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_MAX_BYTES=10485760

# Integrated frontend. Keep PORT equal to uvicorn --port (Render provides PORT).
PORT=5400
FRONTEND_PUBLIC_ORIGIN=http://127.0.0.1:5400
# No BACKEND_URL or separate worker is needed for uvicorn app.main:app.
CAREERLENS_GUEST_ANALYSIS=1
# Optional: an existing durable disk file. Default: frontend/.runtime/guest-reports.sqlite3.
# On ephemeral deployment filesystems, guest/claimed reports may not survive redeploys.
# CAREERLENS_GUEST_STORE_PATH=/existing-private-disk/guest-reports.sqlite3
# Optional durable execution report directory: use the same path for writer and reader.
# EVALUATION_EXECUTION_REPORT_DIR=/existing-private-disk/execution-reports
# CAREERLENS_EXECUTION_REPORTS_DIR=/existing-private-disk/execution-reports
