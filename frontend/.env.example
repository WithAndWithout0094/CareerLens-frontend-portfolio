# Optional standalone frontend development only: python frontend/server.py.
# Normal fullstack execution uses root .env and uvicorn app.main:app.
# Do not copy backend credentials here; never commit either .env file.
BACKEND_URL=http://127.0.0.1:5400
FRONTEND_PORT=5401
FRONTEND_HOST=127.0.0.1
FRONTEND_PUBLIC_ORIGIN=http://127.0.0.1:5401
# BACKEND_URL is the API origin, with no /api path. Remote APIs require HTTPS.
# This standalone process needs the same root Python dependencies as the API.

# Guest analysis imports the monorepo root app/ and root server-only model settings.
# Set 0 to disable new guest calculations; owned reports remain authenticated.
CAREERLENS_GUEST_ANALYSIS=1
# Optional existing durable storage. Omit to use frontend/.runtime/guest-reports.sqlite3.
# CAREERLENS_GUEST_STORE_PATH=/existing-private-disk/guest-reports.sqlite3
# Optional execution report reader path. Match backend EVALUATION_EXECUTION_REPORT_DIR.
# CAREERLENS_EXECUTION_REPORTS_DIR=/existing-private-disk/execution-reports
# Optional public fixture catalog directory; do not use a local Windows path on Render.
# CAREERLENS_JOB_POSTINGS_DIR=
